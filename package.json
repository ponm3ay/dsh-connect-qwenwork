{
  "name": "dsh-connect-qwenwork",
  "displayName": "DSH Connect QwenWork",
  "version": "0.4.0",
  "description": "把千问办公（QwenWork）接入 DeepSeek Harness：浏览器授权自己的账号，进程内回环反代 + 官方 WASM 签名组件，无需 API Key、无需常驻 magpie。",
  "author": "ErkundenSie",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icons/dsh-connect-qwenwork-128.png"
  },
  "files": [
    "lib",
    "icons",
    "locale",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    ".qwenwork-runtime/qoder-auth-wasm/qoder_auth_wasm_bg.wasm"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "capabilities": "node scripts/capabilities.mjs",
    "mount": "node scripts/mount.mjs",
    "client": "node scripts/client.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node --test test/*.test.mjs && node scripts/client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.7-rc.1 <0.3.0-0",
    "@earendil-works/pi-ai": ">=1.0.0-0 <2.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "qwenwork",
    "model-provider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErkundenSie/dsh-connect-qwenwork.git"
  }
}



